+                    tok::TokenKind::annot_unreal_metadata_specifier,
+                    this->AllocSpecifier(MetadataName.str(),
+                                         PEEK_PP_TOKEN().getKind() ==
+                                                 tok::TokenKind::kw_true
+                                             ? "true"
+                                             : "false")));
+              }
