+    if (Tok.getAnnotationValue() == nullptr) {
+      HandlePragmaUnreal(Tok.getKind(), UnrealSpecifier());
+    } else {
+      HandlePragmaUnreal(Tok.getKind(),
+                         *(UnrealSpecifier *)Tok.getAnnotationValue());
+    }
+  }
+}
